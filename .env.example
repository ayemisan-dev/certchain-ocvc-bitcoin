# ─── Flask ───────────────────────────────────────────────
FLASK_ENV=development
FLASK_DEBUG=0
FLASK_HOST=127.0.0.1
FLASK_PORT=8000
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# ─── Bitcoin Network ────────────────────────────────────
# regtest | testnet | mainnet
BITCOIN_NETWORK=regtest
BITCOIN_RPC_HOST=127.0.0.1
BITCOIN_RPC_PORT=8332
BITCOIN_RPC_USER=
BITCOIN_RPC_PASSWORD=
BITCOIN_RPC_TIMEOUT=120

# ─── Bitcoin Indexer (bc_index / indexer) ───────────────
INDEXER_ENABLED=true
INDEXER_BASE_URL=http://127.0.0.1:5000
INDEXER_TIMEOUT=10

# ─── IPFS Backend ───────────────────────────────────────
# filebase | local
IPFS_BACKEND=local
# Local IPFS (regtest offline fallback)
IPFS_LOCAL_API_URL=/ip4/127.0.0.1/tcp/5001
# Filebase (https://console.filebase.com)
FILEBASE_IPFS_RPC_URL=https://rpc.filebase.io
FILEBASE_IPFS_RPC_TOKEN=REPLACE_ME

# ─── Logging ────────────────────────────────────────────
LOG_LEVEL=INFO

# ─── Issuance (CLI) ─────────────────
ISSUER_WIF_PRIVATE_KEY=REPLACE_ME
ISSUER_PUBLIC_KEY=REPLACE_ME
REVOCATION_WIF_PRIVATE_KEY=REPLACE_ME
REVOCATION_PUBLIC_KEY=REPLACE_ME